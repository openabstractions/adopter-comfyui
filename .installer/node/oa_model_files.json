{
  "version": 1,
  "about": "Which ComfyUI template model files are the same model as files OpenAbstractions keeps in its local store (OA-models/<set>). A file's identity is family, role and variant; OA substitutes a file only within the same family and role. A variant is the same weights in another format or quantization; a distillation or fine-tune, such as FastWan from Wan 2.2, is its own family, which OA only suggests and never substitutes. loaders lists the ComfyUI loader classes that load a file; an empty list means ComfyUI cannot load it. A loader with custom_node comes from that custom node pack; Step 1 never installs custom nodes, so a file only such a loader loads stays out of ComfyUI's lists and swaps never target such a loader. sets names the store folders this ComfyUI reads; their files are pinned by size and SHA-256 (openabstractions-flat/abstraction-provider-modelhost/go/host/videopin.go).",
  "loaders": {
    "UNETLoader": {"category": "diffusion_models", "file": "unet_name", "widgets": ["unet_name", "weight_dtype"]},
    "UnetLoaderGGUF": {"category": "diffusion_models", "file": "unet_name", "widgets": ["unet_name"], "custom_node": "ComfyUI-GGUF"},
    "CLIPLoader": {"category": "text_encoders", "file": "clip_name", "widgets": ["clip_name", "type", "device"]},
    "CLIPLoaderGGUF": {"category": "text_encoders", "file": "clip_name", "widgets": ["clip_name", "type"], "custom_node": "ComfyUI-GGUF"},
    "VAELoader": {"category": "vae", "file": "vae_name", "widgets": ["vae_name"]},
    "LatentUpscaleModelLoader": {"category": "latent_upscale_models", "file": "model_name", "widgets": ["model_name"]}
  },
